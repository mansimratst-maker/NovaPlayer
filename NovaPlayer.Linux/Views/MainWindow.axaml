<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia" xmlns:local="clr-namespace:NovaPlayer.Linux" xmlns:controls="clr-namespace:NovaPlayer.Linux.Controls" x:Class="NovaPlayer.Linux.Views.MainWindow" Title="Nivora Player" Icon="/Assets/novaplayer.ico" Width="1510" Height="920" MinWidth="1120" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#070B18" Foreground="#F4F5FF">
  <Window.Resources>
    <local:PathBitmapConverter x:Key="PathBitmap"/><local:HasPathConverter x:Key="HasPath"/><local:NoPathConverter x:Key="NoPath"/>
    <SolidColorBrush x:Key="Canvas" Color="#080C19"/><SolidColorBrush x:Key="Panel" Color="#0F162B"/><SolidColorBrush x:Key="Panel2" Color="#111A32"/><SolidColorBrush x:Key="Line" Color="#263354"/><SolidColorBrush x:Key="Muted" Color="#909AB9"/><SolidColorBrush x:Key="Accent" Color="#8153FF"/>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="Button.nav"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#D8DDF0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="14,10"/><Setter Property="CornerRadius" Value="12"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="0,2"/></Style>
    <Style Selector="Button.nav:pointerover"><Setter Property="Background" Value="#191D3C"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.action"><Setter Property="Background" Value="#18223D"/><Setter Property="Foreground" Value="#F5F5FF"/><Setter Property="BorderBrush" Value="#354368"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="13,9"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style Selector="Button.action:pointerover"><Setter Property="Background" Value="#29214D"/><Setter Property="BorderBrush" Value="#8A67FF"/></Style>
    <Style Selector="Button.round"><Setter Property="Background" Value="#121A30"/><Setter Property="Foreground" Value="#EEF0FF"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="22"/><Setter Property="Width" Value="44"/><Setter Property="Height" Value="44"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style Selector="Button.round:pointerover"><Setter Property="Background" Value="#29204F"/><Setter Property="RenderTransform" Value="scale(1.06)"/></Style>
    <Style Selector="Button.play"><Setter Property="Background" Value="#824EFF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#BCA4FF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="26"/><Setter Property="Width" Value="54"/><Setter Property="Height" Value="54"/><Setter Property="FontSize" Value="21"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style Selector="Button.play:pointerover"><Setter Property="Background" Value="#9A70FF"/><Setter Property="RenderTransform" Value="scale(1.07)"/></Style>
    <Style Selector="Slider"><Setter Property="Foreground" Value="#8B5CFF"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style Selector="Border.queue-item"><Setter Property="Background" Value="#0B1327"/><Setter Property="BorderBrush" Value="#202D4C"/></Style>
    <Style Selector="Border.queue-item.active"><Setter Property="Background" Value="#28205C"/><Setter Property="BorderBrush" Value="#7E61FF"/></Style>
    <Style Selector="Border.queue-item:pointerover"><Setter Property="BorderBrush" Value="#9A7AFF"/></Style>
  </Window.Styles>
  <Grid RowDefinitions="58,*" ColumnDefinitions="218,*" Margin="1">
    <Border Grid.RowSpan="2" Background="#0A0F20" BorderBrush="#202A45" BorderThickness="0,0,1,0">
      <DockPanel Margin="16,14">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="7,4,0,30"><Border Width="38" Height="38" CornerRadius="14" Background="#7443F7"><controls:NovaIcon Kind="play" IconSize="18" Stroke="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0"><TextBlock Text="Nivora Player" FontSize="17" FontWeight="Bold"/><TextBlock Text="MEDIA, REIMAGINED" FontSize="8" Foreground="#A2ACCC"/></StackPanel></StackPanel>
          <Button Classes="nav" Click="NavigateHome_Click"><StackPanel Orientation="Horizontal" Spacing="12"><controls:NovaIcon Kind="home" IconSize="21" Stroke="#BBA7FF"/><TextBlock Text="Home" VerticalAlignment="Center"/></StackPanel></Button>
          <Button Classes="nav" Click="Refresh_Click"><StackPanel Orientation="Horizontal" Spacing="12"><controls:NovaIcon Kind="library" IconSize="19" Stroke="#BBA7FF"/><TextBlock Text="Media Library" VerticalAlignment="Center"/></StackPanel></Button>
          <Button Classes="nav" Click="FilterVideos_Click"><StackPanel Orientation="Horizontal" Spacing="12"><controls:NovaIcon Kind="video" IconSize="19" Stroke="#BBA7FF"/><TextBlock Text="Videos" VerticalAlignment="Center"/></StackPanel></Button>
          <Button Classes="nav" Click="FilterMusic_Click"><StackPanel Orientation="Horizontal" Spacing="12"><controls:NovaIcon Kind="music" IconSize="19" Stroke="#BBA7FF"/><TextBlock Text="Music" VerticalAlignment="Center"/></StackPanel></Button>
          <Button Classes="nav" Click="History_Click"><StackPanel Orientation="Horizontal" Spacing="12"><controls:NovaIcon Kind="history" IconSize="19" Stroke="#BBA7FF"/><TextBlock Text="Recently Played" VerticalAlignment="Center"/></StackPanel></Button>
          <Button Classes="nav" Click="Favorites_Click"><StackPanel Orientation="Horizontal" Spacing="12"><controls:NovaIcon Kind="heart" IconSize="19" Stroke="#BBA7FF"/><TextBlock Text="Favorites" VerticalAlignment="Center"/></StackPanel></Button>
          <Button Classes="nav" Click="Playlists_Click"><StackPanel Orientation="Horizontal" Spacing="12"><controls:NovaIcon Kind="playlist" IconSize="19" Stroke="#BBA7FF"/><TextBlock Text="Playlists" VerticalAlignment="Center"/></StackPanel></Button>
          <Button Classes="nav" Click="Settings_Click"><StackPanel Orientation="Horizontal" Spacing="12"><controls:NovaIcon Kind="settings" IconSize="19" Stroke="#BBA7FF"/><TextBlock Text="Settings" VerticalAlignment="Center"/></StackPanel></Button>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Background="#141C35" CornerRadius="14" Padding="14" Margin="0,14,0,2"><StackPanel><StackPanel Orientation="Horizontal" Spacing="5"><controls:NovaIcon Kind="play" IconSize="13" Stroke="#B49BFF"/><TextBlock Text="NOVAPLAYER" Foreground="#B49BFF" FontSize="10" FontWeight="Bold"/></StackPanel><TextBlock Text="Every frame. Every sound." FontWeight="SemiBold" FontSize="12" Margin="0,10,0,3"/><TextBlock Text="Beautifully played." Foreground="#98A5C7" FontSize="11"/></StackPanel></Border>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Background="#0A0F20" Margin="0,0,1,0" PointerPressed="TitleBar_PointerPressed">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0"><TextBlock Text="NOVA PLAYER" Foreground="#8F9ABA" FontSize="9"/><TextBlock Text="  /  YOUR SPACE" Foreground="#6F7C9D" FontSize="9"/></StackPanel>
      <Border Grid.Column="1" Width="350" Height="38" Background="#131B30" BorderBrush="#26314C" BorderThickness="1" CornerRadius="12" Margin="10,0"><StackPanel Orientation="Horizontal" Margin="10,0" Spacing="8"><controls:NovaIcon Kind="search" IconSize="18" Stroke="#AAB6D5" VerticalAlignment="Center"/><TextBox x:Name="SearchBox" Watermark="Search your library..." Background="Transparent" BorderThickness="0" Foreground="White" VerticalContentAlignment="Center" TextChanged="Search_TextChanged"/></StackPanel></Border>
      <Button Grid.Column="2" Classes="action" Margin="7,0" Click="OpenFiles_Click"><StackPanel Orientation="Horizontal" Spacing="6"><controls:NovaIcon Kind="plus" IconSize="15" Stroke="#E7E4FF"/><TextBlock Text="Open file"/></StackPanel></Button>
      <Button Grid.Column="3" Classes="action" Margin="0,0,14,0" Click="AddFolder_Click"><StackPanel Orientation="Horizontal" Spacing="6"><controls:NovaIcon Kind="folder" IconSize="17" Stroke="#E7E4FF"/><TextBlock Text="Add folder"/></StackPanel></Button>
    </Grid>
    <Grid x:Name="MainLayoutGrid" Grid.Column="1" Grid.Row="1" ColumnDefinitions="*,Auto" RowDefinitions="*,270" Margin="16,14">
      <Border x:Name="VideoHost" Grid.Row="0" Grid.Column="0" Background="#060914" BorderBrush="#26314C" BorderThickness="1" CornerRadius="18" ClipToBounds="True">
        <vlc:VideoView x:Name="VideoSurface" MediaPlayer="{Binding Player}">
          <vlc:VideoView.Content>
            <Grid x:Name="PlayerOverlay" RowDefinitions="*,Auto" PointerMoved="PlayerOverlay_PointerMoved" PointerExited="PlayerOverlay_PointerExited" Background="Transparent">
              <Grid x:Name="EmptyState" IsVisible="True"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9"><Border Width="78" Height="78" CornerRadius="28" Background="#211A42"><controls:NovaIcon Kind="play" IconSize="32" Stroke="#B18CFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Every Frame. Every Sound." FontSize="27" FontWeight="Light" HorizontalAlignment="Center" Margin="0,8,0,0"/><TextBlock Text="Your next favorite moment starts here." Foreground="#98A5C7" HorizontalAlignment="Center"/><Button Classes="action" HorizontalAlignment="Center" Margin="0,12,0,0" Click="OpenFiles_Click">Open a media file</Button></StackPanel></Grid>
              <Grid x:Name="OverlayHeader" VerticalAlignment="Top" Margin="18,16" ColumnDefinitions="*,Auto" IsVisible="False" Opacity="0"><Grid.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.18"/></Transitions></Grid.Transitions><Border Background="#C5141B34" BorderBrush="#4A5780" BorderThickness="1" CornerRadius="15" Padding="13,9" HorizontalAlignment="Left"><StackPanel><TextBlock Text="NOW PLAYING" Foreground="#B59CFF" FontSize="9" FontWeight="Bold"/><TextBlock Text="{Binding CurrentTitle}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="620"/></StackPanel></Border><Button x:Name="ScaleButton" Grid.Column="1" Classes="action" Click="ScaleMode_Click">Fit  ⌄</Button></Grid>
              <Border x:Name="QuickControls" Grid.Row="1" Background="#EA0C142B" BorderBrush="#746C91FF" BorderThickness="1" CornerRadius="24" Padding="20,11" Margin="20,0,20,18" IsVisible="False" Opacity="0" BoxShadow="0 0 26 0 #2A6248FF"><Border.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.18"/></Transitions></Border.Transitions><Grid RowDefinitions="25,60" ColumnDefinitions="54,*,60"><TextBlock Grid.RowSpan="2" Text="{Binding PositionLabel}" FontSize="11" VerticalAlignment="Center" Foreground="#F0F1FF"/><Slider x:Name="Timeline" Grid.Column="1" Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position, Mode=TwoWay}" IsHitTestVisible="True" PointerReleased="Timeline_Released"/><TextBlock Grid.RowSpan="2" Grid.Column="2" Text="{Binding DurationLabel}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#F0F1FF"/><StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                <Button Classes="round" ToolTip.Tip="Subtitles" Click="Subtitle_Click"><controls:NovaIcon Kind="subtitles" IconSize="18"/></Button>
                <Button Classes="round" ToolTip.Tip="Previous (P)" Click="Previous_Click"><controls:NovaIcon Kind="previous" IconSize="18"/></Button>
                <Button Classes="round" ToolTip.Tip="Back 10 seconds" Click="SeekBack_Click"><StackPanel Orientation="Horizontal" Spacing="2"><controls:NovaIcon Kind="rewind" IconSize="16"/><TextBlock Text="10" FontSize="10" VerticalAlignment="Center"/></StackPanel></Button>
                <Button Classes="play" ToolTip.Tip="Play or pause (Space)" Click="PlayPause_Click"><controls:NovaIcon x:Name="PlayPauseIcon" Kind="play" IconSize="22" Stroke="White"/></Button>
                <Button Classes="round" ToolTip.Tip="Forward 10 seconds" Click="SeekForward_Click"><StackPanel Orientation="Horizontal" Spacing="2"><TextBlock Text="10" FontSize="10" VerticalAlignment="Center"/><controls:NovaIcon Kind="forward" IconSize="16"/></StackPanel></Button>
                <Button Classes="round" ToolTip.Tip="Next (N)" Click="Next_Click"><controls:NovaIcon Kind="next" IconSize="18"/></Button>
                <Border Width="1" Height="21" Background="#465274" Margin="7,0" VerticalAlignment="Center"/>
                <Button Classes="round" ToolTip.Tip="Mute (M)" Click="Mute_Click"><controls:NovaIcon Kind="volume" IconSize="18"/></Button>
                <Slider x:Name="VolumeSlider" Width="92" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}"/>
                <Button Classes="round" ToolTip.Tip="Picture in picture" Click="Pip_Click"><controls:NovaIcon Kind="pip" IconSize="18"/></Button>
                <Button Classes="round" ToolTip.Tip="Fullscreen (F)" Click="Fullscreen_Click"><controls:NovaIcon Kind="fullscreen" IconSize="18"/></Button>
              </StackPanel></Grid></Border>
            </Grid>
          </vlc:VideoView.Content>
        </vlc:VideoView>
      </Border>
      <Border Grid.Column="1" Grid.Row="0" Width="264" Background="#0E152A" BorderBrush="#222F4C" BorderThickness="1" CornerRadius="17" Padding="12" Margin="12,0,0,0" IsVisible="{Binding IsQueueVisible}"><DockPanel><Grid DockPanel.Dock="Top" Margin="3,3,2,11" ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="UP NEXT" Foreground="#A891FF" FontSize="9"/><TextBlock Text="{Binding QueueTitle}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Classes="round" Width="36" Height="36" Click="OpenFiles_Click"><controls:NovaIcon Kind="plus" IconSize="18"/></Button></Grid><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="2,8,0,0" Spacing="5"><Button Classes="round" ToolTip.Tip="Shuffle" Click="Shuffle_Click"><controls:NovaIcon Kind="shuffle" IconSize="18"/></Button><Button Classes="action" Click="Repeat_Click"><TextBlock Text="{Binding RepeatLabel}"/></Button><Button Classes="round" ToolTip.Tip="Hide queue" Click="ToggleQueue_Click"><controls:NovaIcon Kind="playlist" IconSize="18"/></Button></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Queue}"><ItemsControl.ItemTemplate><DataTemplate><Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" Margin="0,3" Click="QueueItem_Click" Loaded="QueueCard_Loaded"><Border Classes="queue-item" Classes.active="{Binding IsNowPlaying}" BorderThickness="1" CornerRadius="13" Padding="8"><Grid ColumnDefinitions="72,*,22"><Border Width="66" Height="50" CornerRadius="9" Background="#202C49" ClipToBounds="True"><Grid><Image Source="{Binding ThumbnailPath, Converter={StaticResource PathBitmap}}" Stretch="UniformToFill" IsVisible="{Binding ThumbnailPath, Converter={StaticResource HasPath}}"/><TextBlock Text="▶" Foreground="#B6A0FF" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ThumbnailPath, Converter={StaticResource NoPath}}"/></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0"><TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DurationText}" Foreground="#929FBE" FontSize="10" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2" IsVisible="{Binding IsNowPlaying}"><Border Width="3" Height="9" CornerRadius="2" Background="#C4ACFF"/><Border Width="3" Height="16" CornerRadius="2" Background="#8059FF"/><Border Width="3" Height="11" CornerRadius="2" Background="#D9CAFF"/></StackPanel></Grid></Border></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel></Border>
      <Border Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Background="#0F162A" BorderBrush="#202B47" BorderThickness="1" CornerRadius="16" Padding="13" Margin="0,11,0,0"><DockPanel><Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="3,0,0,7"><StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="YOUR COLLECTION" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="· local media" Foreground="#8F9BB7" FontSize="10" VerticalAlignment="Center"/></StackPanel><Button Grid.Column="1" Classes="round" Width="36" Height="34" Click="Refresh_Click"><controls:NovaIcon Kind="refresh" IconSize="18"/></Button></Grid><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding MediaItems}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,11,10" Click="LibraryItem_Click" Loaded="LibraryCard_Loaded"><Border Width="170" Background="#0B1326" BorderBrush="#263453" BorderThickness="1" CornerRadius="13" Padding="8"><StackPanel><Border Height="83" CornerRadius="9" Background="#1C2742" ClipToBounds="True"><Grid><Image Source="{Binding ThumbnailPath, Converter={StaticResource PathBitmap}}" Stretch="UniformToFill" IsVisible="{Binding ThumbnailPath, Converter={StaticResource HasPath}}"/><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ThumbnailPath, Converter={StaticResource NoPath}}"><controls:NovaIcon Kind="video" IconSize="24" Stroke="#9F7BFF" HorizontalAlignment="Center"/><TextBlock Text="{Binding Extension}" FontSize="9" Foreground="#CFD4E7" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel><Border Background="#99070B18" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="7" Padding="6,3" Margin="6"><TextBlock Text="{Binding Extension}" FontSize="8" Foreground="#E7E8F5"/></Border></Grid></Border><TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Margin="3,8,3,2" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SizeText}" FontSize="10" Foreground="#8D9ABC" Margin="3,0"/></StackPanel></Border></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel></Border>
    </Grid>
    <Border Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Background="#0E152A" BorderBrush="#202A45" BorderThickness="1,0,0,0" IsVisible="False"/>
  </Grid>
</Window>
