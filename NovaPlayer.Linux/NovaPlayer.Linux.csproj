<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NovaPlayer.Linux</AssemblyName>
    <RootNamespace>NovaPlayer.Linux</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.23" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.10.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\NovaPlayer\Models\MediaItem.cs" Link="Models\MediaItem.cs" />
    <Compile Include="..\NovaPlayer\Models\SavedPlaylist.cs" Link="Models\SavedPlaylist.cs" />
    <Compile Include="..\NovaPlayer\Database\LibraryDatabase.cs" Link="Database\LibraryDatabase.cs" />
    <Compile Include="..\NovaPlayer\Services\MediaLibraryService.cs" Link="Services\MediaLibraryService.cs" />
    <Compile Include="..\NovaPlayer\Services\IMediaLibraryService.cs" Link="Services\IMediaLibraryService.cs" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="..\NovaPlayer\Assets\novaplayer.ico" Link="Assets\novaplayer.ico" />
    <AvaloniaResource Include="..\NovaPlayer\Assets\novaplayer.png" Link="Assets\novaplayer.png" />
  </ItemGroup>
</Project>
