        <Border x:Name="PlaylistPanel" Grid.Column="1" Background="{DynamicResource Panel}" CornerRadius="13" BorderBrush="#202B45" BorderThickness="1" Padding="13"><DockPanel><Grid DockPanel.Dock="Top" Margin="3,3,3,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="UP NEXT" Foreground="#9D8AFF" FontSize="9"/><TextBlock Text="{Binding QueueLabel}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Command="{Binding OpenFileCommand}" Style="{StaticResource IconActionButton}" ToolTip="Add media to queue"><controls:NovaIcon Kind="plus" Size="18"/></Button></Grid><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Queue}" ItemTemplate="{StaticResource QueueItem}"/></ScrollViewer><StackPanel DockPanel.Dock="Bottom" Margin="4,10,0,0"><Border Height="1" Background="#293550" Margin="0,0,0,10"/><StackPanel Orientation="Horizontal"><Button Command="{Binding ToggleShuffleCommand}" Style="{StaticResource IconActionButton}" ToolTip="Shuffle"><controls:NovaIcon Kind="shuffle" Size="18"/></Button><Button Command="{Binding CycleRepeatCommand}" Style="{StaticResource NavButton}" Padding="10,8" ToolTip="Repeat mode: off, one, all" AutomationProperties.Name="Repeat mode"><StackPanel Orientation="Horizontal"><controls:NovaIcon Kind="repeat" Size="18" Margin="0,0,7,0"/><TextBlock Text="{Binding RepeatLabel}"/></StackPanel></Button><Button Command="{Binding TogglePlaylistCommand}" Style="{StaticResource IconActionButton}" ToolTip="Hide playlist"><controls:NovaIcon Kind="playlist" Size="18"/></Button></StackPanel><TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}" FontSize="10" Margin="5,8,2,0" TextWrapping="Wrap"/></StackPanel></DockPanel></Border>
        <Border x:Name="SettingsPage" Grid.Column="0" Grid.ColumnSpan="2" Background="{DynamicResource Canvas}" CornerRadius="16" Visibility="Collapsed"><Grid Margin="25"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="2,0,2,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="YOUR EXPERIENCE" Foreground="{DynamicResource AccentLight}" FontSize="9" FontWeight="Bold"/><TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,2"/><TextBlock Text="Make Nivora Player feel like yours." Foreground="#929FBC" FontSize="12"/></StackPanel><Button Grid.Column="1" Click="SettingsBack_Click" Style="{StaticResource ActionButton}" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><controls:NovaIcon Kind="arrow-left" Size="18" Margin="0,0,7,0"/><TextBlock Text="Back to player"/></StackPanel></Button></Grid><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Background="{DynamicResource GlassSurface}" BorderBrush="#554F6EFF" BorderThickness="1" CornerRadius="20" Padding="20" Margin="0,0,9,12"><StackPanel><TextBlock Text="APPEARANCE" Foreground="{DynamicResource AccentLight}" FontSize="9" FontWeight="Bold"/><TextBlock Text="Nivora Violet" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,2"/><TextBlock Text="A calm midnight canvas with one signature violet accent." Foreground="#B2BCD4" FontSize="11"/><Border Background="#1C2340" BorderBrush="#4C456E" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,16,0,0"><StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="{DynamicResource Accent}" Margin="0,0,10,0"/><StackPanel><TextBlock Text="SIGNATURE VIOLET" Foreground="#E8E4FF" FontSize="10" FontWeight="Bold"/><TextBlock Text="Fixed across the complete interface" Foreground="#929DBB" FontSize="10" Margin="0,3,0,0"/></StackPanel></StackPanel></Border><TextBlock Text="A translucent glass finish with restrained highlights keeps media in focus." Foreground="#8794B2" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
          <Border Grid.Column="1" Background="{DynamicResource Panel}" BorderBrush="#293653" BorderThickness="1" CornerRadius="18" Padding="20" Margin="9,0,0,12"><StackPanel><TextBlock Text="PLAYBACK" Foreground="{DynamicResource AccentLight}" FontSize="9" FontWeight="Bold"/><TextBlock Text="Playback preferences" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,12"/><CheckBox Content="Hardware acceleration" IsChecked="{Binding HardwareAccelerationEnabled}" Style="{StaticResource SettingsSwitch}" Margin="0,5,0,3"/><TextBlock Text="Use GPU decoding when the device and codec support it." Foreground="#8390AD" FontSize="10" Margin="0,0,0,12"/><CheckBox Content="Remember playback position" IsChecked="{Binding RememberPositionEnabled}" Style="{StaticResource SettingsSwitch}" Margin="0,5,0,3"/><TextBlock Text="Resume files where you left off and keep recent history." Foreground="#8390AD" FontSize="10" Margin="0,0,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Default volume" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding DefaultVolume, StringFormat={}{0:0}%}" Foreground="#D6CAFF" FontSize="11" VerticalAlignment="Center"/></Grid><Slider Minimum="0" Maximum="100" Value="{Binding DefaultVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Border></Grid>
          <Border Background="{DynamicResource Panel}" BorderBrush="#293653" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,0,0,12"><DockPanel><StackPanel DockPanel.Dock="Top"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MEDIA LIBRARY" Foreground="{DynamicResource AccentLight}" FontSize="9" FontWeight="Bold"/><TextBlock Text="Your folders" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,3"/><TextBlock Text="Folders registered with Nivora Player are scanned for supported video and audio files." Foreground="#98A5C1" FontSize="11" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Command="{Binding OpenFolderCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><controls:NovaIcon Kind="folder-plus" Size="18" Margin="0,0,7,0"/><TextBlock Text="Add folder"/></StackPanel></Button><Button Command="{Binding RefreshLibraryCommand}" Style="{StaticResource IconActionButton}" ToolTip="Refresh media library"><controls:NovaIcon Kind="refresh" Size="18"/></Button></StackPanel></Grid><Border Height="1" Background="#27334E" Margin="0,15,0,12"/></StackPanel><ScrollViewer MaxHeight="135" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding LibraryFolders}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#0B1121" CornerRadius="10" Padding="10,8" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><controls:NovaIcon Kind="folder" Size="18" Stroke="{DynamicResource AccentLight}" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding}" Foreground="#D5DDF3" FontSize="11" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Clear playback history" Command="{Binding ClearHistoryCommand}" Style="{StaticResource NavButton}" Margin="0,0,8,0"/><Button Content="Reset settings" Command="{Binding ResetSettingsCommand}" Style="{StaticResource ActionButton}"/></StackPanel></DockPanel></Border>
          <TextBlock Text="Nivora Player  ·  Settings are stored locally on this device" Foreground="#65728F" FontSize="10" HorizontalAlignment="Right" Margin="2,1,4,8"/>
        </StackPanel></ScrollViewer></Grid></Border>
        <Border x:Name="PlaylistsPage" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2" Background="{DynamicResource Canvas}" CornerRadius="16" Visibility="Collapsed"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Grid.Row="0" Margin="3,0,3,17"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="YOUR LISTENING, YOUR WAY" Foreground="{DynamicResource AccentLight}" FontSize="9" FontWeight="Bold"/><TextBlock Text="Playlists" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,2"/><TextBlock Text="Build a collection for every mood and moment." Foreground="#98A5C1" FontSize="12"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBox Width="220" Text="{Binding SavedPlaylistName, UpdateSourceTrigger=PropertyChanged}" Background="#131B30" Foreground="White" BorderBrush="#303F5F" BorderThickness="1" Padding="10,8" VerticalContentAlignment="Center" ToolTip="Playlist name"/><Button Command="{Binding SavePlaylistCommand}" Style="{StaticResource AccentButton}" Margin="8,0,0,0"><StackPanel Orientation="Horizontal"><controls:NovaIcon Kind="check" Size="16" Margin="0,0,7,0"/><TextBlock Text="Save playlist"/></StackPanel></Button></StackPanel></Grid><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource Panel}" BorderBrush="#273450" BorderThickness="1" CornerRadius="16" Padding="12" Margin="0,0,12,0"><DockPanel><Grid DockPanel.Dock="Top" Margin="4,2,4,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="COLLECTIONS" Foreground="{DynamicResource AccentLight}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/><Button Grid.Column="1" Command="{Binding CreatePlaylistCommand}" Style="{StaticResource IconActionButton}" ToolTip="Create playlist"><controls:NovaIcon Kind="plus" Size="18"/></Button></Grid><ItemsControl ItemsSource="{Binding SavedPlaylists}"><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.SelectPlaylistCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,2"><Border Background="#121B32" BorderBrush="#263452" BorderThickness="1" CornerRadius="12" Padding="11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="30" Height="30" CornerRadius="10" Background="#33265F"><controls:NovaIcon Kind="playlist" Size="16" Stroke="#BAA7FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ItemCount, StringFormat={}{0} tracks}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/></StackPanel></Grid></Border></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock DockPanel.Dock="Bottom" Text="Playlists are saved on this device." Foreground="#7D89A7" FontSize="10" Margin="5,12,0,0" TextWrapping="Wrap"/></DockPanel></Border><Border Grid.Column="1" Background="{DynamicResource Panel}" BorderBrush="#273450" BorderThickness="1" CornerRadius="16" Padding="16"><DockPanel><Grid DockPanel.Dock="Top" Margin="3,1,3,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PLAYLIST DETAILS" Foreground="{DynamicResource AccentLight}" FontSize="9" FontWeight="Bold"/><TextBlock Text="{Binding SelectedPlaylist.Name, TargetNullValue=Choose a playlist}" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Command="{Binding PlaySelectedPlaylistCommand}" Style="{StaticResource AccentButton}" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><controls:NovaIcon Kind="play" Size="16" Margin="0,0,7,0"/><TextBlock Text="Play all"/></StackPanel></Button><Button Command="{Binding DeletePlaylistCommand}" CommandParameter="{Binding SelectedPlaylist}" Style="{StaticResource IconActionButton}" ToolTip="Delete selected playlist"><controls:NovaIcon Kind="trash" Size="18"/></Button></StackPanel></Grid><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding SelectedPlaylistItems}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource Card}" BorderBrush="#202D47" BorderThickness="1" CornerRadius="11" Padding="8" Margin="0,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><controls:NovaIcon Kind="music" Size="18" Stroke="{DynamicResource AccentLight}" VerticalAlignment="Center" HorizontalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DurationText}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Command="{Binding DataContext.MovePlaylistItemUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource IconActionButton}" ToolTip="Move up"><controls:NovaIcon Kind="chevron-down" Size="16" RenderTransformOrigin="0.5,0.5"><controls:NovaIcon.RenderTransform><RotateTransform Angle="180"/></controls:NovaIcon.RenderTransform></controls:NovaIcon></Button><Button Command="{Binding DataContext.MovePlaylistItemDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource IconActionButton}" ToolTip="Move down"><controls:NovaIcon Kind="chevron-down" Size="16"/></Button><Button Command="{Binding DataContext.RemoveFromPlaylistCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource IconActionButton}" ToolTip="Remove from playlist"><controls:NovaIcon Kind="close" Size="16"/></Button></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock DockPanel.Dock="Bottom" Text="Change the playlist name above · use the arrows to reorder tracks." Foreground="#7D89A7" FontSize="10" Margin="4,10,0,0"/></DockPanel></Border></Grid></Grid></Border>
