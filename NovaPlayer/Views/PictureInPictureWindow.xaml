<Window x:Class="NovaPlayer.Views.PictureInPictureWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:NovaPlayer.Controls" Title="NovaPlayer · Picture in Picture" Width="700" Height="440" MinWidth="420" MinHeight="300" WindowStyle="None" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False" KeyDown="Window_KeyDown" Background="#070A14" Foreground="White" UseLayoutRounding="True">
  <Border Background="#080B16" BorderBrush="#795CFF" BorderThickness="1" CornerRadius="15" ClipToBounds="True">
    <Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid x:Name="TitleBar" Background="#11182B" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="13,0"><Border Width="22" Height="22" CornerRadius="8" Background="#7948F4"><controls:NovaIcon Kind="play" Size="14"/></Border><TextBlock Text="{Binding CurrentMedia.Title, FallbackValue=NovaPlayer}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,0,0" MaxWidth="440"/></StackPanel><Button Grid.Column="1" Click="ReturnToMain_Click" Style="{StaticResource CloseWindowButton}" ToolTip="Return to NovaPlayer" Width="42" Height="36" Margin="0,1,4,1"><controls:NovaIcon Kind="close" Size="18"/></Button></Grid>
      <Grid x:Name="VideoHost" Grid.Row="1" Background="#050813"/>
    </Grid>
  </Border>
</Window>
